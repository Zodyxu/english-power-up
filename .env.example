# Englify environment variables. Copy to .env (local dev) and set real values.
# Never commit real keys. Production values are set as Cloudflare Workers
# secrets (`wrangler secret put ...`) / dashboard environment variables.

# --- Client-safe (bundled into the frontend; anon key is RLS-protected) ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Server-only (NEVER expose with a VITE_ prefix) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
